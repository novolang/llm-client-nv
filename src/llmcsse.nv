// llmcsse.nv — the streamed reply: server-sent event frames, and the
// accumulator that turns them back into one reply.
//
// `[]` throughout, feed-and-drain, with the loop in the host.  The
// caller reads bytes off its own transport and hands them here; this
// answers frames, the dialect turns a frame into events, and
// `apply` folds an event into the partial reply.  Nothing here reads
// a socket, so a whole streamed exchange is a byte array in a test.
//
// WHY A STREAM IS NOT A CALLBACK.  `std.llm.stream` takes one, and its
// own page records what that costs: on the compiled leg the whole
// reply is delivered in a single call, so a program written against
// the callback is a program whose "streaming" silently is not.  A
// callback also decides for the caller where the loop lives, which is
// the one decision a library should not make — a terminal repainting
// per delta, an HTTP server forwarding to its own client and an agent
// counting tokens all want different loops.
//
// THE THREE THINGS A WRONG SSE READER GETS WRONG QUIETLY:
//
//   A FRAME ENDS AT A BLANK LINE, NOT AT A NEWLINE.  A `data:` line is
//   one line of a frame and a frame may have several; a reader that
//   emitted per line splits one JSON document into pieces and reports
//   the first as malformed.
//
//   `data: [DONE]` IS NOT JSON.  It is the OpenAI dialect's terminator
//   and a reader that parsed every frame reports a malformed reply at
//   the end of every SUCCESSFUL stream.  `is_done` is the check.
//
//   TOOL-CALL ARGUMENTS ARRIVE SPLIT AT ARBITRARY BYTE BOUNDARIES.
//   There is a point in every tool-calling stream at which the
//   accumulated arguments are `{"city": "Cope`.  A reader that parsed
//   each delta reports malformed JSON for most of the stream; the
//   arguments accumulate as TEXT and are parsed once, which is also
//   why `LlmcToolCall.arguments` is a `Str`.
//
// AND THE ONE THAT IS NOT QUIET, WHICH IS WHY `finish` ANSWERS A
// RESULT: A STREAM THAT ENDS WITH NO TERMINAL EVENT IS A TRUNCATED
// REPLY.  The connection dropped, the deadline fired, the proxy cut
// it — and the text accumulated so far reads exactly like an answer.
// `finish` refuses with `LlmcStreamTruncated`, carrying how much
// arrived; `partial` is the accessor for a caller that wants to show
// it anyway, named so that showing it is a decision.

use std.bytes
use std.list
use std.str
use llmcfault
use llmcreply

// One server-sent event, assembled from its lines.
pub struct LlmcSseFrame
    // The `event:` field, or empty.  The Anthropic dialect names every
    // frame (`content_block_delta`, `message_stop`); the OpenAI one
    // names none and puts the discriminator inside the data.
    event: Str
    // The `data:` field, with multiple `data:` lines joined by a
    // newline, as the specification requires.
    data: Str
    // The `id:` field, or empty.
    id: Str
    // The `retry:` field in milliseconds, or -1 when absent.
    retry_ms: Int

// The reader between "some bytes turned up" and "here is a frame".
//
// Opaque: the fields are here because a struct needs them, and a
// caller that reaches into one has coupled itself to a buffering
// decision this module intends to change.
pub struct LlmcSseReader
    pending: [u8]
    offset: Int
    max_frame: Int

// A reader and the one frame that came out of it, if one did.
pub struct LlmcSseStep
    reader: LlmcSseReader
    frame: ?LlmcSseFrame

// A reader with the default frame limit.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     println("${llmcsse.reader().max_frame}")
// ```
pub fn reader() -> LlmcSseReader []
    reader_with(1048576)

// A reader that refuses a frame larger than `max_frame` bytes.
//
// A limit rather than a growing buffer, because the peer decides how
// much it sends: a stream that never blanks a line is a stream that
// buffers until the process dies, and a program talking to a gateway
// it does not own should be able to say how much it will hold.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     println("${llmcsse.reader_with(65536).max_frame}")
//     // : 65536
// ```
pub fn reader_with(max_frame: Int) -> LlmcSseReader []
    LlmcSseReader { pending: [], offset: 0, max_frame: max_frame }

// Feed bytes, and take the first frame they completed.
//
// The frame is `None` when the bytes did not finish one.  Call `take`
// until it answers `None` to drain the rest: one chunk off a socket
// routinely completes several.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     match llmcsse.feed(llmcsse.reader(), [])
//         Ok(_)  => println("fed")
//         Err(_) => println("refused")
// ```
pub fn feed(r: LlmcSseReader, data: [u8]) -> Result<LlmcSseStep, LlmcFault> []
    var joined: [u8] = []
    for i in r.offset..list.len(r.pending)
        list.push(joined, r.pending[i])
    for b in data
        list.push(joined, b)
    take(LlmcSseReader { pending: joined, offset: 0, max_frame: r.max_frame })

// Take the next frame out of what has already been fed.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     match llmcsse.take(llmcsse.reader())
//         Ok(_)  => println("taken")
//         Err(_) => println("refused")
// ```
pub fn take(r: LlmcSseReader) -> Result<LlmcSseStep, LlmcFault> []
    let buf = r.pending
    let n = list.len(buf)
    var frame_start = r.offset
    var pos = r.offset
    var event = ""
    var data = ""
    var has_data = false
    var id = ""
    var retry_ms = 0 - 1
    while pos < n
        var e = pos
        while e < n and buf[e] != 10 and buf[e] != 13
            e = e + 1
        if e >= n
            break
        var next = e + 1
        if buf[e] == 13
            if next >= n
                break
            if buf[next] == 10
                next = next + 1
        if e == pos
            if has_data
                if next - frame_start > r.max_frame
                    return Err(too_large(r.max_frame))
                let fr = LlmcSseFrame { event: event, data: data, id: id, retry_ms: retry_ms }
                return Ok(LlmcSseStep { reader: LlmcSseReader { pending: buf, offset: next, max_frame: r.max_frame },
                    frame: Some(fr) })
            frame_start = next
            event = ""
            id = ""
            retry_ms = 0 - 1
        else
            let line = text_of(buf, pos, e)
            let colon = str.index(line, ":") ?? 0 - 1
            if colon != 0
                var field = line
                var value = ""
                if colon > 0
                    field = str.slice(line, 0, colon)
                    value = str.slice(line, colon + 1, str.len(line))
                    if str.starts_with(value, " ")
                        value = str.slice(value, 1, str.len(value))
                if field == "data"
                    if has_data
                        data = data + "\n" + value
                    else
                        data = value
                    has_data = true
                elif field == "event"
                    event = value
                elif field == "id"
                    id = value
                elif field == "retry"
                    retry_ms = str.to_int(value) ?? retry_ms
        pos = next
    if n - frame_start > r.max_frame
        return Err(too_large(r.max_frame))
    Ok(LlmcSseStep { reader: LlmcSseReader { pending: buf, offset: frame_start, max_frame: r.max_frame },
        frame: None })

// How many fed bytes have not yet made a frame.
//
// Published so a test asserts directly that a reader holds nothing
// whose size the peer chose, rather than trusting a paragraph.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     println("${llmcsse.pending_len(llmcsse.reader())}")
//     // : 0
// ```
pub fn pending_len(r: LlmcSseReader) -> Int []
    list.len(r.pending) - r.offset

// Whether this frame is the OpenAI dialect's `[DONE]` terminator.
//
// Which is not JSON, and is the reason a reader that parsed every
// frame reports a malformed reply at the end of every successful
// stream.
//
// ```novo
// use llmcsse
//
// fn done(f: LlmcSseFrame) -> Bool
//     llmcsse.is_done(f)
// ```
pub fn is_done(f: LlmcSseFrame) -> Bool []
    str.trim(f.data) == "[DONE]"

// What one frame of a stream said, after its dialect decoded it.
//
// One vocabulary for both dialects.  The Anthropic dialect emits these
// almost one to one from its named events; the OpenAI dialect derives
// them from the deltas in each chunk.
pub enum LlmcEvent
    // The reply has an id and a model.  First, once.
    LlmcEventStart(id: Str, model: Str)
    // More text.  A DELTA, not the text so far.
    LlmcEventText(delta: Str)
    // A tool call begins.  `index` is its position in the turn, which
    // is what the argument deltas are keyed by — the id and the name
    // arrive once, and everything after them arrives by index.
    LlmcEventToolStart(index: Int, id: Str, name: Str)
    // More argument text for the tool call at `index`.  Accumulates as
    // TEXT; nothing parses until the stream is finished.
    LlmcEventToolArgs(index: Int, delta: Str)
    // The usage, which arrives at the END of a stream — and on the
    // OpenAI dialect only when the request asked for it.
    LlmcEventUsage(usage: LlmcUsage)
    // The reply ended, and why.  The terminal event `finish` requires.
    LlmcEventStop(stop: LlmcStop)
    // A keep-alive.  Carries nothing, and a reader that treated it as
    // content appends an empty string forever.
    LlmcEventPing

// The partial reply a stream has built so far.
//
// A VALUE, like everything else in this package: `apply` takes one and
// answers one, so a caller can keep the state wherever its loop keeps
// state and a test can assert an exact intermediate.
pub struct LlmcStream
    id: Str
    model: Str
    text: Str
    tool_ids: [Str]
    tool_names: [Str]
    tool_args: [Str]
    usage: LlmcUsage
    stop: ?LlmcStop

// An empty accumulator.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     println("${llmcsse.stream().text}")
//     // :
// ```
pub fn stream() -> LlmcStream []
    LlmcStream { id: "", model: "", text: "", tool_ids: [], tool_names: [],
                 tool_args: [], usage: llmcreply.no_usage(), stop: None }

// Fold one event into the accumulator.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     let s = llmcsse.apply(llmcsse.stream(), LlmcEventText("hel"))
//     println(llmcsse.apply(s, LlmcEventText("lo")).text)
//     // : hello
// ```
pub fn apply(s: LlmcStream, e: LlmcEvent) -> LlmcStream []
    match e
        LlmcEventStart(id, model)           =>
            LlmcStream { id: id, model: model, text: s.text, tool_ids: s.tool_ids,
                         tool_names: s.tool_names, tool_args: s.tool_args,
                         usage: s.usage, stop: s.stop }
        LlmcEventText(delta)                =>
            LlmcStream { id: s.id, model: s.model, text: s.text + delta,
                         tool_ids: s.tool_ids, tool_names: s.tool_names,
                         tool_args: s.tool_args, usage: s.usage, stop: s.stop }
        LlmcEventToolStart(index, id, name) =>
            var ids = padded(s.tool_ids, index + 1)
            var names = padded(s.tool_names, index + 1)
            var args = padded(s.tool_args, index + 1)
            ids[index] = id
            names[index] = name
            LlmcStream { id: s.id, model: s.model, text: s.text, tool_ids: ids,
                         tool_names: names, tool_args: args, usage: s.usage,
                         stop: s.stop }
        LlmcEventToolArgs(index, delta)     =>
            var ids = padded(s.tool_ids, index + 1)
            var names = padded(s.tool_names, index + 1)
            var args = padded(s.tool_args, index + 1)
            args[index] = args[index] + delta
            LlmcStream { id: s.id, model: s.model, text: s.text, tool_ids: ids,
                         tool_names: names, tool_args: args, usage: s.usage,
                         stop: s.stop }
        LlmcEventUsage(u)                   =>
            LlmcStream { id: s.id, model: s.model, text: s.text, tool_ids: s.tool_ids,
                         tool_names: s.tool_names, tool_args: s.tool_args,
                         usage: merged(s.usage, u), stop: s.stop }
        LlmcEventStop(stop)                 =>
            LlmcStream { id: s.id, model: s.model, text: s.text, tool_ids: s.tool_ids,
                         tool_names: s.tool_names, tool_args: s.tool_args,
                         usage: s.usage, stop: first_stop(s.stop, stop) }
        LlmcEventPing                       => s

// Fold a whole frame's events at once.
//
// ```novo
// use llmcsse
//
// fn fold(s: LlmcStream, es: [LlmcEvent]) -> LlmcStream
//     llmcsse.apply_all(s, es)
// ```
pub fn apply_all(s: LlmcStream, es: [LlmcEvent]) -> LlmcStream []
    var acc = s
    for e in es
        acc = apply(acc, e)
    acc

// Whether a terminal event has arrived.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     println("${llmcsse.finished(llmcsse.stream())}")
//     // : false
// ```
pub fn finished(s: LlmcStream) -> Bool []
    match s.stop
        Some(_) => true
        None    => false

// The reply as it stands, whether or not the stream finished.
//
// For a caller painting deltas as they arrive, and for the one that
// wants to show a truncated answer after `finish` refused it.  Named
// so that showing an unfinished reply is a decision somebody made.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     println("${llmcsse.partial(llmcsse.stream()).text}")
//     // :
// ```
pub fn partial(s: LlmcStream) -> LlmcReply []
    var calls: [LlmcToolCall] = []
    for i in 0..list.len(s.tool_ids)
        // Anthropic numbers every content block, so a tool call after a
        // text block starts at index 1 and leaves index 0 empty.
        if s.tool_ids[i] != "" or s.tool_names[i] != "" or s.tool_args[i] != ""
            list.push(calls, LlmcToolCall { id: s.tool_ids[i], name: s.tool_names[i],
                                            arguments: s.tool_args[i] })
    let stop = match s.stop
        Some(st) => st
        None     => LlmcStopOther("the stream had not finished")
    LlmcReply { stop: stop, text: s.text, tool_calls: calls, usage: s.usage,
                model: s.model, id: s.id }

// The finished reply, or a refusal.
//
// `LlmcStreamTruncated` when no terminal event arrived, carrying how
// many characters did — because a stream that dropped has text in it
// that reads exactly like an answer, and a `?LlmcReply` would have
// made "the connection died" and "the model said nothing" the same
// value.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     match llmcsse.finish(llmcsse.stream())
//         Ok(_)  => println("finished")
//         Err(_) => println("truncated")
//     // : truncated
// ```
pub fn finish(s: LlmcStream) -> Result<LlmcReply, LlmcFault> []
    if not finished(s)
        return Err(LlmcStreamTruncated(str.len(s.text)))
    Ok(partial(s))

// The text delta an event carries, or empty.
//
// The one-line convenience a terminal repainting per frame wants, so
// the common loop is not a `match` over seven variants.
//
// ```novo
// use llmcsse
//
// fn main() [io]
//     println(llmcsse.text_delta(LlmcEventText("hi")))
//     // : hi
// ```
pub fn text_delta(e: LlmcEvent) -> Str []
    match e
        LlmcEventText(delta) => delta
        _                    => ""

// The refusal for a frame the peer never ended.
fn too_large(max_frame: Int) -> LlmcFault
    LlmcMalformedReply("an event frame under ${max_frame} bytes")

// The bytes `lo` up to `hi` as text.
fn text_of(buf: [u8], lo: Int, hi: Int) -> Str
    var part: [Int] = []
    for i in lo..hi
        list.push(part, buf[i])
    bytes.byte_list_to_str(part)

// The list grown with empty strings until it holds `n`.
fn padded(xs: [Str], n: Int) -> [Str]
    var out = list.clone(xs)
    while list.len(out) < n
        list.push(out, "")
    out

// A stream's usage with the newer report laid over the older: a field
// the newer one left at zero keeps its earlier value, because
// Anthropic reports the input count at the start and the output count
// at the end.
fn merged(old: LlmcUsage, new: LlmcUsage) -> LlmcUsage
    LlmcUsage { input_tokens: later(old.input_tokens, new.input_tokens),
                output_tokens: later(old.output_tokens, new.output_tokens),
                cached_input_tokens: later(old.cached_input_tokens, new.cached_input_tokens),
                reasoning_tokens: later(old.reasoning_tokens, new.reasoning_tokens) }

fn later(old: Int, new: Int) -> Int
    if new > 0
        new
    else
        old

// The stop already recorded, or this one.
//
// The first stop wins: Anthropic names the reason on `message_delta`
// and then ends the stream with a bare `message_stop`, which the
// dialect reads as an end of turn.  The later one must not turn a
// `max_tokens` into an end.
fn first_stop(have: ?LlmcStop, stop: LlmcStop) -> ?LlmcStop
    match have
        Some(_) => have
        None    => Some(stop)
