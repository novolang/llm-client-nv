// llmchttp.nv — the transport, and the only module in this package
// that touches a socket.
//
// `LlmcTransport[e]` IS THE TRAIT THAT CROSSES THE LAYER.  Every
// session call in `llmcchat` is generic over it and declares `[e]`, so
// a call costs exactly what the caller's transport costs — and a test
// drives a whole exchange over a recorded transcript at `[]`.
//
// TWO TRANSPORTS SHIP, AND THE DIFFERENCE IS THE PACKAGE'S EFFECT ROW:
//
//   `LlmcTlsHttp` IS `[net]`.  `std.tls` connects, sends and receives
//   at `[net]` and nothing else, and http-codec-nv frames the request
//   and drains the response at `[]`.  That is the narrow path, and it
//   is what makes the package's headline row `[net, time]`.
//
//   `LlmcStdHttp` IS `[io, net, time, async]`.  `std.http`'s
//   `HttpClient.send` declares all four — the async runtime is not
//   optional on that surface — so a caller that wants redirects,
//   connection reuse and the standard library's own chunked decoder
//   pays those four labels on every function that touches it.
//
// PUBLISHING BOTH IS THE POINT.  A library that only offered the
// second would have put `[async]` on the row of every program that
// uses an LLM, including a synchronous batch job and an embedded-in-a-
// CLI one-shot; a library that only offered the first would have made
// every caller reimplement redirects.  The trait is what makes the
// choice the caller's, and `tests/llmcchat_tests.nv` adds a third at
// `[]` with no socket at all.
//
// STREAMING IS `llmc_open` PLUS `llmc_read`, NOT `llmc_exchange`.  A
// server-sent event stream has no content length and is not finished
// when the head is; a transport that buffered it would deliver the
// whole reply at once, which is what `std.llm.stream` does on the
// compiled leg and is exactly the behaviour this package exists to
// replace.

use std.bytes
use std.list
use std.str
use std.tls
use h1msg
use h1read
use h1write
use llmcreq
use llmcfault

// One HTTP response, as much of it as a transport has.
pub struct LlmcHttpReply
    status: Int
    // `Name: value` lines, as they arrived.  `header_of` is the
    // case-insensitive lookup.
    headers: [Str]
    // The buffered body.  EMPTY when `streamed` is true, and a caller
    // that read it instead of draining the stream gets nothing and no
    // error.
    body: [u8]
    // True when the body was left on the wire for `llmc_read`.
    streamed: Bool

// A byte pipe one chat exchange can be driven over.
//
// `e` is the effect row the implementation supplies, and it is what
// every call in `llmcchat` costs: `[net]` over TLS, `[io, net, time,
// async]` over the standard library's HTTP client, and nothing at all
// over a recorded transcript in a test.
//
// Every method takes `var self`.  A streamed exchange has to remember
// its connection between `llmc_open` and `llmc_read`, and the language
// refuses a write through a plain `self`; the two shipped transports
// keep that state in a one-slot list that every copy of the value
// shares, so a copy made before the call sees what the call stored.
// A transport that keeps no state ignores the permission.  A caller
// passes `var t` to the session calls for the same reason.
pub trait LlmcTransport[e]
    // Send one request and buffer the whole response.
    fn llmc_exchange(var self, method: Str, path: Str, headers: [Str], body: [u8]) -> Result<LlmcHttpReply, LlmcFault> [e]
    // Send one request and stop after the head, leaving the body on
    // the wire for `llmc_read`.  What a stream needs, and the reason
    // the trait has four methods rather than one.
    fn llmc_open(var self, method: Str, path: Str, headers: [Str], body: [u8]) -> Result<LlmcHttpReply, LlmcFault> [e]
    // Up to `max` bytes of a body left on the wire.  An EMPTY answer
    // means the peer closed — which, mid-stream, is
    // `LlmcStreamTruncated` and not the end of a reply.
    fn llmc_read(var self, max: Int) -> Result<[u8], LlmcFault> [e]
    // Close it.
    fn llmc_close(var self) -> ?LlmcFault [e]

// A transport over the standard library's HTTP client.
//
// Redirects, connection reuse and chunked decoding come with it, and
// so does `[io, net, time, async]`.
pub struct LlmcStdHttp
    client: HttpClient
    base_url: Str
    // The connection a streamed exchange left open, in a one-slot list
    // that every copy of this value shares: a trait method takes
    // `self` by value, and a list is the only place the next
    // `llmc_read` can find what `llmc_open` opened.
    var live: [LlmcLive]

// A transport over `std.tls` with http-codec-nv doing the framing.
//
// `[net]` and nothing else.  No redirects — a chat endpoint that
// answered a 302 is a gateway misconfiguration and this one reports
// it as the status it is.
pub struct LlmcTlsHttp
    host: Str
    port: Int
    // The receive deadline in milliseconds, 0 for none.
    timeout_ms: Int
    // The current connection and what has been read off it, in a
    // one-slot list that every copy of this value shares.
    var wire: [LlmcWire]

// The standard-library connection a streamed exchange is reading.
pub struct LlmcLive
    conn: HttpConn
    reader: HttpReplyReader

// A TLS connection, the response reader over it and the body bytes a
// `llmc_read` has been handed and not yet returned.
pub struct LlmcWire
    conn: Int
    reader: H1Reader
    // Body bytes the reader produced beyond what the last `llmc_read`
    // asked for.
    held: [u8]
    // The response has ended.
    done: Bool
    // An exchange has used this connection.  The request says
    // `Connection: close`, so the next one dials again.
    used: Bool

// A standard-library transport for a provider.
//
// Building one performs nothing; `llmc_exchange` is where the four
// labels are spent.
//
// ```novo
// use llmchttp
// use llmcreq
//
// fn t(p: LlmcProvider) -> Bool
//     match llmchttp.std_http(p, 30000)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn std_http(p: LlmcProvider, timeout_ms: Int) -> Result<LlmcStdHttp, LlmcFault> []
    let client = HttpClient.new(p.base_url).with_timeout(timeout_ms)
    Ok(LlmcStdHttp { client: client, base_url: p.base_url, live: [] })

// Dial a provider over TLS.
//
// `[net]`, which is `std.tls`'s own row and the narrowest way to reach
// a hosted API from this package.
//
// ```novo ignore
// use llmchttp
// use llmcreq
//
// fn open(p: LlmcProvider) -> Result<LlmcTlsHttp, LlmcFault> [net]
//     llmchttp.dial_tls(p, 30000)
// ```
pub fn dial_tls(p: LlmcProvider, timeout_ms: Int) -> Result<LlmcTlsHttp, LlmcFault> [net]
    let o = origin_of(p)!
    if o.scheme != "https"
        return Err(LlmcUnsupported("the ${o.scheme} scheme", "the TLS transport"))
    let conn = connect_tls(o.host, o.port, timeout_ms)!
    Ok(LlmcTlsHttp { host: o.host, port: o.port, timeout_ms: timeout_ms,
                     wire: [fresh_wire(conn)] })

// The host and port a provider's origin names.
//
// `[]` — parsing a URL is arithmetic.  Published because a caller that
// wants to dial the socket itself, or to route through a proxy, needs
// the two numbers and should not re-parse an origin this package
// already understands.
//
// ```novo
// use llmchttp
// use llmcreq
//
// fn main() [io]
//     match llmchttp.origin_of(llmcreq.openai("sk-test"))
//         Ok(o)  => println("${o.port}")
//         Err(_) => println("bad origin")
//     // : 443
// ```
pub fn origin_of(p: LlmcProvider) -> Result<LlmcOrigin, LlmcFault> []
    let origin = p.base_url
    var scheme = ""
    var rest = origin
    match str.index(origin, "://")
        Some(at) =>
            scheme = str.lower(str.slice(origin, 0, at))
            rest = str.slice(origin, at + 3, str.len(origin))
        None     =>
            return Err(LlmcBadEncoding("the origin ${origin} has no scheme://"))
    if scheme != "http" and scheme != "https"
        return Err(LlmcUnsupported("the ${scheme} scheme", "the HTTP transports"))
    match str.index(rest, "/")
        Some(at) =>
            rest = str.slice(rest, 0, at)
        None     => 0
    var host = rest
    var port = 80
    if scheme == "https"
        port = 443
    var tail = rest
    if str.starts_with(rest, "[")
        match str.index(rest, "]")
            Some(close) =>
                host = str.slice(rest, 0, close + 1)
                tail = str.slice(rest, close + 1, str.len(rest))
            None        =>
                return Err(LlmcBadEncoding("the origin ${origin} has an unclosed [ in its host"))
    else
        match str.index(rest, ":")
            Some(at) =>
                host = str.slice(rest, 0, at)
                tail = str.slice(rest, at, str.len(rest))
            None     =>
                tail = ""
    if str.starts_with(tail, ":")
        match str.to_int(str.slice(tail, 1, str.len(tail)))
            Some(n) =>
                port = n
            None    =>
                return Err(LlmcBadEncoding("the origin ${origin} has a port that is not a number"))
    elif tail != ""
        return Err(LlmcBadEncoding("the origin ${origin} has text after its host"))
    if host == "" or port < 1 or port > 65535
        return Err(LlmcBadEncoding("the origin ${origin} names no usable host and port"))
    Ok(LlmcOrigin { scheme: scheme, host: host, port: port })

// A provider's origin, split.
pub struct LlmcOrigin
    scheme: Str
    host: Str
    port: Int

// One header's value, matched without regard to case.
//
// HTTP field names are case-insensitive and providers disagree about
// which case they send — `Retry-After` and `retry-after` both occur
// from the same API — so a client that compared exactly reads the
// limits from one deployment and not the next.
//
// ```novo
// use llmchttp
//
// fn main() [io]
//     match llmchttp.header_of(["Retry-After: 6"], "retry-after")
//         Some(v) => println(v)
//         None    => println("absent")
//     // : 6
// ```
pub fn header_of(headers: [Str], name: Str) -> ?Str []
    let want = str.lower(name)
    for line in headers
        match str.index(line, ":")
            Some(at) =>
                if str.lower(str.trim(str.slice(line, 0, at))) == want
                    return Some(str.trim(str.slice(line, at + 1, str.len(line))))
            None     => 0
    None

// Whether a response is a server-sent event stream.
//
// `Content-Type: text/event-stream`.  A provider that answered JSON to
// a streaming request did not refuse it — it ignored the field, which
// several OpenAI-compatible servers do — and a client that drove the
// stream reader over a single JSON document reads nothing and reports
// a truncated stream.  This is the check that makes that legible.
//
// ```novo
// use llmchttp
//
// fn main() [io]
//     println("${llmchttp.is_event_stream(["Content-Type: text/event-stream"])}")
//     // : true
// ```
pub fn is_event_stream(headers: [Str]) -> Bool []
    match header_of(headers, "content-type")
        Some(v) => str.contains(str.lower(v), "text/event-stream")
        None    => false

// The standard library's HTTP client as a transport.
//
// `[io, net, time, async]` on every method, which is `HttpClient`'s
// own row: the async runtime, the clock behind the deadline and the
// `[io]` the socket layer declares all come with it.  A caller who
// does not want those four uses `LlmcTlsHttp`.
//
// ```novo ignore
// use llmcchat
// use llmchttp
//
// fn ask(c: LlmcClient, var t: LlmcStdHttp, r: LlmcRequest) -> Result<LlmcReply, LlmcFault> [io, net, time, async]
//     llmcchat.send(c, var t, r)
// ```
impl LlmcTransport[io, net, time, async] for LlmcStdHttp
    fn llmc_exchange(var self, method: Str, path: Str, headers: [Str],
                     body: [u8]) -> Result<LlmcHttpReply, LlmcFault> [io, net, time, async]
        var client = self.client
        for line in headers
            match str.index(line, ":")
                Some(at) =>
                    client = client.with_header(str.trim(str.slice(line, 0, at)),
                                                str.trim(str.slice(line, at + 1, str.len(line))))
                None     => 0
        match client.send(method, path, bytes.from_byte_list(as_ints(body)))
            Err(e)    => Err(std_fault(e, self.client.timeout_ms))
            Ok(reply) =>
                Ok(LlmcHttpReply { status: reply.status, headers: reply.headers,
                                   body: bytes.to_byte_list(reply.body), streamed: false })

    fn llmc_open(var self, method: Str, path: Str, headers: [Str],
                 body: [u8]) -> Result<LlmcHttpReply, LlmcFault> [io, net, time, async]
        match self.client.connect()
            Err(e) => Err(std_fault(e, self.client.timeout_ms))
            Ok(k)  =>
                match k.open(method, path, headers, bytes.from_byte_list(as_ints(body)))
                    Err(e)    => Err(std_fault(e, self.client.timeout_ms))
                    Ok(reply) =>
                        list.push(self.live, LlmcLive { conn: k, reader: k.reader(reply) })
                        Ok(LlmcHttpReply { status: reply.status, headers: reply.headers,
                                           body: [], streamed: true })

    fn llmc_read(var self, max: Int) -> Result<[u8], LlmcFault> [io, net, time, async]
        if list.len(self.live) == 0
            return Err(LlmcTransportFailed("llmc_read before llmc_open"))
        // workaround(a-trait-method-call-on-a-field-of-a-list-element-leaks-the-receiver):
        // `self.live[0].reader.read(max)` leaks two objects per read, so
        // the element and its field are bound first.
        let w = self.live[0]
        let reader = w.reader
        match reader.read(max)
            Err(e)    => Err(LlmcTransportFailed("reading the body: ${e.message()}"))
            Ok(chunk) => Ok(bytes.to_byte_list(chunk))

    fn llmc_close(var self) -> ?LlmcFault [io, net, time, async]
        if list.len(self.live) == 0
            return None
        self.live[0].conn.close()
        None

// TLS plus http-codec-nv as a transport.
//
// `[net]` on every method, which is `std.tls`'s own row: the framing
// is http-codec-nv's and costs nothing, so this is the narrowest path
// to a hosted API the package has.
//
// ```novo ignore
// use llmcchat
// use llmchttp
//
// fn ask(c: LlmcClient, var t: LlmcTlsHttp, r: LlmcRequest) -> Result<LlmcReply, LlmcFault> [net]
//     llmcchat.send(c, var t, r)
// ```
impl LlmcTransport[net] for LlmcTlsHttp
    fn llmc_exchange(var self, method: Str, path: Str, headers: [Str],
                     body: [u8]) -> Result<LlmcHttpReply, LlmcFault> [net]
        let conn = reconnect(var self)!
        send_request(conn, self.host, method, path, headers, body)!
        var rd = h1read.expect(h1read.reader(ReadsResponses, h1read.default_limits()),
                               method_of(method))
        var status = 0
        var reply_headers: [Str] = []
        var out: [u8] = []
        loop
            let got = next_event(conn, rd, self.timeout_ms)!
            rd = got.reader
            match got.event
                ResponseHead(resp) =>
                    status = resp.status
                    reply_headers = header_lines(resp.headers)
                BodyBytes(data)    =>
                    for b in data
                        list.push(out, b)
                MessageDone        =>
                    if status >= 200
                        return Ok(LlmcHttpReply { status: status, headers: reply_headers,
                                                  body: out, streamed: false })
                _                  => 0

    fn llmc_open(var self, method: Str, path: Str, headers: [Str],
                 body: [u8]) -> Result<LlmcHttpReply, LlmcFault> [net]
        let conn = reconnect(var self)!
        send_request(conn, self.host, method, path, headers, body)!
        var rd = h1read.expect(h1read.reader(ReadsResponses, h1read.default_limits()),
                               method_of(method))
        loop
            let got = next_event(conn, rd, self.timeout_ms)!
            rd = got.reader
            match got.event
                ResponseHead(resp) =>
                    if resp.status >= 200
                        self.wire[0] = LlmcWire { conn: conn, reader: rd, held: [],
                                                  done: false, used: true }
                        return Ok(LlmcHttpReply { status: resp.status,
                                                  headers: header_lines(resp.headers),
                                                  body: [], streamed: true })
                _                  => 0

    fn llmc_read(var self, max: Int) -> Result<[u8], LlmcFault> [net]
        let w = self.wire[0]
        if list.len(w.held) > 0
            return Ok(hand_out(var self, w, w.held, max))
        if w.done
            return Ok([])
        var rd = w.reader
        loop
            let got = next_event(w.conn, rd, self.timeout_ms)!
            rd = got.reader
            match got.event
                BodyBytes(data) =>
                    return Ok(hand_out(var self, wire_at(w, rd, false), data, max))
                MessageDone     =>
                    self.wire[0] = wire_at(w, rd, true)
                    return Ok([])
                _               => 0

    fn llmc_close(var self) -> ?LlmcFault [net]
        tls.close(self.wire[0].conn)
        None

// A byte list widened to the `[Int]` that `bytes.from_byte_list` takes.
fn as_ints(body: [u8]) -> [Int]
    var out: [Int] = []
    for b in body
        list.push(out, b)
    out

// A standard-library client error as the fault it is.
fn std_fault(e: HttpError, timeout_ms: Int) -> LlmcFault
    match e
        HttpIo(IoTimedOut) => LlmcTimedOut(timeout_ms)
        _                  => LlmcTransportFailed(http.client.error_text(e))

// The reader's three words for a request method.
fn method_of(token: Str) -> H1Method
    h1msg.method_of(token) ?? ExtensionMethod(token)

// A header section as `Name: value` lines.
fn header_lines(h: H1Headers) -> [Str]
    var out: [Str] = []
    for f in h1msg.fields_of(h)
        list.push(out, "${f.name}: ${f.value}")
    out

// A wire that has not carried an exchange yet.
fn fresh_wire(conn: Int) -> LlmcWire
    LlmcWire { conn: conn, reader: h1read.reader(ReadsResponses, h1read.default_limits()),
               held: [], done: false, used: false }

// The same wire with a reader in a new position.
fn wire_at(w: LlmcWire, rd: H1Reader, done: Bool) -> LlmcWire
    LlmcWire { conn: w.conn, reader: rd, held: w.held, done: done, used: w.used }

// Open a TLS connection to a host, verifying its certificate.
fn connect_tls(host: Str, port: Int, timeout_ms: Int) -> Result<Int, LlmcFault> [net]
    match tls.connect(host, port, tls.config_for_client(host))
        None       =>
            Err(LlmcTransportFailed("TLS to ${host}:${port}: ${tls.last_error()}"))
        Some(conn) =>
            if timeout_ms > 0
                tls.set_recv_timeout(conn, timeout_ms)
            Ok(conn)

// The connection this exchange may use: the one dialled, or, when an
// earlier exchange has used it, a new one.
fn reconnect(var t: LlmcTlsHttp) -> Result<Int, LlmcFault> [net]
    let w = t.wire[0]
    if not w.used
        t.wire[0] = LlmcWire { conn: w.conn, reader: w.reader, held: [], done: false, used: true }
        return Ok(w.conn)
    tls.close(w.conn)
    let conn = connect_tls(t.host, t.port, t.timeout_ms)!
    t.wire[0] = LlmcWire { conn: conn, reader: w.reader, held: [], done: false, used: true }
    Ok(conn)

// Frame a request and write it.
fn send_request(conn: Int, host: Str, method: Str, path: Str, headers: [Str],
                body: [u8]) -> Result<Int, LlmcFault> [net]
    var fields: [H1Header] = [H1Header { name: "Host", value: host },
                              H1Header { name: "Connection", value: "close" }]
    for line in headers
        match str.index(line, ":")
            Some(at) =>
                list.push(fields, H1Header { name: str.trim(str.slice(line, 0, at)),
                                             value: str.trim(str.slice(line, at + 1, str.len(line))) })
            None     => 0
    let req = H1Request { method: method_of(method), target: path, version: Http11,
                          headers: h1msg.headers(fields) }
    match h1write.request(req, body)
        Err(e)    => Err(LlmcBadEncoding(e.message()))
        Ok(frame) =>
            if tls.send(conn, bytes.from_byte_list(as_ints(frame)))
                Ok(list.len(frame))
            else
                Err(LlmcTransportFailed("sending the request: ${tls.last_error()}"))

// The reader after one event, and the event.
struct LlmcWireEvent
    reader: H1Reader
    event: H1Event

// The next event of the response, reading the connection when the
// reader holds only part of one.
fn next_event(conn: Int, rd: H1Reader, timeout_ms: Int) -> Result<LlmcWireEvent, LlmcFault> [net]
    var step = decoded(h1read.take(rd))!
    loop
        match step.event
            Some(ev) =>
                return Ok(LlmcWireEvent { reader: step.reader, event: ev })
            None     => 0
        if step.reader.closed
            return Err(LlmcTransportFailed("the connection closed before the response ended"))
        match tls.recv(conn, 65536)
            Some(chunk) =>
                step = decoded(h1read.feed(step.reader, bytes.to_byte_list(chunk)))!
            None        =>
                // The runtime names a receive deadline; any other empty
                // read is the peer closing, with or without a close_notify.
                if str.contains(tls.last_error(), "receive deadline")
                    return Err(LlmcTimedOut(timeout_ms))
                step = decoded(h1read.finish(step.reader))!

// A reader's step, or the decode error as a fault.
fn decoded(r: Result<H1Step, H1DecodeError>) -> Result<H1Step, LlmcFault>
    match r
        Ok(step) => Ok(step)
        Err(e)   =>
            match e
                MessageTruncated(_) =>
                    Err(LlmcTransportFailed("the connection closed before the response ended"))
                _                   => Err(LlmcMalformedReply("an HTTP response: ${e.message()}"))

// Up to `max` of `data` to the caller, the rest kept on the wire.
fn hand_out(var t: LlmcTlsHttp, w: LlmcWire, data: [u8], max: Int) -> [u8]
    if list.len(data) <= max
        t.wire[0] = LlmcWire { conn: w.conn, reader: w.reader, held: [], done: w.done, used: w.used }
        return data[:]
    t.wire[0] = LlmcWire { conn: w.conn, reader: w.reader, held: data[max:], done: w.done, used: w.used }
    data[0:max]
