// llmcreq.nv — the request, the provider it goes to, and what it will
// cost before it goes.
//
// `[]` throughout.  A request is a value, a provider is a value, and
// counting a request's tokens is arithmetic over a vocabulary the
// caller already loaded.
//
// THE PROVIDER IS A VALUE AND THIS PACKAGE READS NO ENVIRONMENT
// VARIABLE.  `std.llm` reads `ANTHROPIC_API_KEY`, `OPENAI_API_KEY` or
// `GROQ_API_KEY` for you, and that is the right choice for a standard
// library's convenience surface and the wrong one for a library three
// reasons over:
//
//   IT DECIDES FOR THE PROGRAM WHICH KEY IT USES.  A program that
//   talks to two accounts, or to one account per tenant, or to a
//   gateway with a rotating token, has no way to say so to an API
//   whose key comes from a name it does not choose.
//
//   IT COSTS `[io]` FOR A STRING THE PROGRAM ALREADY HAS.  Reading the
//   environment is `[io]` under SPEC § 5.1, so a package that read one
//   key would put `[io]` on the row of every caller that never wanted
//   it — including the ones passing a literal in a test.
//
//   IT IS PROCESS-GLOBAL STATE A TEST CANNOT SET PER CASE.  Two tests
//   running against two fake providers in one process cannot both have
//   `OPENAI_API_KEY`.
//
// So `LlmcProvider.api_key` is a `Str` the caller supplies, the
// caller's own `env.get` is where `[io]` is spent, and one line of
// README says which variable name each provider documents.
//
// `redacted` is published beside it because the second thing that
// happens to a provider value is that somebody prints it.

use std.json
use std.list
use std.str
use promptmsg
use tokmodel
use llmcfault

// Which wire dialect a provider speaks.
//
// A VALUE AND NOT A TYPE PARAMETER, which is the decision the package
// is named for.  A program that chose its provider from a
// configuration file has a `Str` at run time, and a type parameter
// would have made it write the same call twice under a `match`.  The
// two dialects are two encode/decode pairs behind one signature, and
// `llmcchat` dispatches on this field.
pub enum LlmcDialect
    // `POST /v1/chat/completions` with a `messages` array, `choices`
    // in the reply, and `tool_calls` on the assistant message.  What
    // OpenAI, Groq, together.ai, vLLM, llama.cpp's server, LM Studio
    // and Ollama's compatibility endpoint all speak.
    LlmcOpenAiChat
    // `POST /v1/messages` with a top-level `system`, a content BLOCK
    // LIST in both directions, and `tool_use` / `tool_result` blocks.
    LlmcAnthropicMessages

// The name in a configuration file: `openai` or `anthropic`.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println(llmcreq.dialect_name(LlmcOpenAiChat))
//     // : openai
// ```
pub fn dialect_name(d: LlmcDialect) -> Str []
    match d
        LlmcOpenAiChat        => "openai"
        LlmcAnthropicMessages => "anthropic"

// The dialect a name selects, or None for a name this package does
// not speak.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     match llmcreq.dialect_of_name("anthropic")
//         Some(d) => println(llmcreq.dialect_name(d))
//         None    => println("unknown")
// ```
pub fn dialect_of_name(name: Str) -> ?LlmcDialect []
    if name == "openai"
        Some(LlmcOpenAiChat)
    elif name == "anthropic"
        Some(LlmcAnthropicMessages)
    else
        None

// Where a request goes and what it carries on the way.
//
// Everything that is true of the ENDPOINT rather than of the request:
// a program holds one of these for the life of a process and builds
// many requests against it.
pub struct LlmcProvider
    dialect: LlmcDialect
    // The ORIGIN, with no path: `https://api.openai.com`.  `chat_path`
    // appends the rest, because the two dialects put their endpoint in
    // different places and a caller that concatenated by hand gets a
    // 404 that reads like a wrong key.
    base_url: Str
    // The key, as the caller read it.  Empty is legal and is what a
    // local server wants; `key_is_set` is the question, and the
    // encoders never put an empty bearer on the wire.
    api_key: Str
    // Anthropic's `anthropic-version`, which that API requires on
    // every request and which pins the response shape.  Empty for the
    // OpenAI dialect, which versions by URL.
    api_version: Str
    // `OpenAI-Organization`, or empty.  A field rather than an extra
    // header because it is the one OpenAI account setting that changes
    // which quota a request is billed against.
    organization: Str
    // `Name: value` lines added to every request — a gateway's token,
    // a trace id, a beta feature flag.  In the order given.
    extra_headers: [Str]

// OpenAI's own endpoint, with a key.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println(llmcreq.provider_base_url(llmcreq.openai("sk-test")))
//     // : https://api.openai.com
// ```
pub fn openai(api_key: Str) -> LlmcProvider []
    LlmcProvider { dialect: LlmcOpenAiChat,
        base_url: "https://api.openai.com",
        api_key: api_key,
        api_version: "",
        organization: "",
        extra_headers: [] }

// Anthropic's own endpoint, with a key and the version this package
// was written against.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println(llmcreq.anthropic("sk-ant-test").api_version)
// ```
pub fn anthropic(api_key: Str) -> LlmcProvider []
    LlmcProvider { dialect: LlmcAnthropicMessages,
        base_url: "https://api.anthropic.com",
        api_key: api_key,
        api_version: "2023-06-01",
        organization: "",
        extra_headers: [] }

// Any server that speaks the OpenAI chat dialect: llama.cpp's server,
// vLLM, LM Studio, an mlserve instance, Ollama's `/v1` endpoint, a
// gateway.
//
// The key may be empty, and for a local server it usually is.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     let p = llmcreq.compatible("http://127.0.0.1:8080", "")
//     println("${llmcreq.key_is_set(p)}")
//     // : false
// ```
pub fn compatible(base_url: Str, api_key: Str) -> LlmcProvider []
    LlmcProvider { dialect: LlmcOpenAiChat,
        base_url: base_url,
        api_key: api_key,
        api_version: "",
        organization: "",
        extra_headers: [] }

// The same provider pointed at another origin.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     let p = llmcreq.with_base_url(llmcreq.openai("sk-test"), "https://gw.example.com")
//     println(llmcreq.provider_base_url(p))
//     // : https://gw.example.com
// ```
pub fn with_base_url(p: LlmcProvider, base_url: Str) -> LlmcProvider []
    LlmcProvider { dialect: p.dialect,
        base_url: base_url,
        api_key: p.api_key,
        api_version: p.api_version,
        organization: p.organization,
        extra_headers: p.extra_headers }

// The same provider with one more header on every request.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     let p = llmcreq.with_header(llmcreq.openai("sk-test"), "X-Trace", "abc")
//     println("${list.len(p.extra_headers)}")
//     // : 1
// ```
pub fn with_header(p: LlmcProvider, name: Str, value: Str) -> LlmcProvider []
    var hs = list.clone(p.extra_headers)
    list.push(hs, "${name}: ${value}")
    LlmcProvider { dialect: p.dialect,
        base_url: p.base_url,
        api_key: p.api_key,
        api_version: p.api_version,
        organization: p.organization,
        extra_headers: hs }

// The same provider with another API version pinned.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     let p = llmcreq.with_api_version(llmcreq.anthropic("sk-ant-test"), "2023-06-01")
//     println(p.api_version)
//     // : 2023-06-01
// ```
pub fn with_api_version(p: LlmcProvider, version: Str) -> LlmcProvider []
    LlmcProvider { dialect: p.dialect,
        base_url: p.base_url,
        api_key: p.api_key,
        api_version: version,
        organization: p.organization,
        extra_headers: p.extra_headers }

// The origin, as a plain accessor for a caller that does not want to
// reach into the struct.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println(llmcreq.provider_base_url(llmcreq.compatible("http://localhost:11434", "")))
//     // : http://localhost:11434
// ```
pub fn provider_base_url(p: LlmcProvider) -> Str []
    p.base_url

// Whether a key was supplied.
//
// A local server wants no key and a hosted one refuses without it, so
// this is a question and not an error: `llmcchat` uses it to decide
// whether to send an `Authorization` header at all, and an empty
// bearer never travels.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${llmcreq.key_is_set(llmcreq.openai("sk-test"))}")
//     // : true
// ```
pub fn key_is_set(p: LlmcProvider) -> Bool []
    p.api_key != ""

// The provider as one line with the key REPLACED by its last four
// characters.
//
// Published because the second thing that happens to a provider value
// is that somebody prints it, and a key in a log file is a key that
// has to be rotated.  Never round-trips: this is for a person.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println(llmcreq.redacted(llmcreq.openai("sk-secret-1234")))
//     // : openai https://api.openai.com key=…1234
// ```
pub fn redacted(p: LlmcProvider) -> Str []
    let n = str.len(p.api_key)
    var key = "none"
    if n > 8
        key = "…" + str.slice(p.api_key, n - 4, n)
    elif n > 0
        key = "****"
    "${dialect_name(p.dialect)} ${p.base_url} key=${key}"

// The path a chat request is posted to, appended to `base_url`.
//
// `/v1/chat/completions` for the OpenAI dialect and `/v1/messages` for
// Anthropic's.  A function rather than a field because a caller that
// wrote the path by hand against the wrong dialect gets a 404 that
// reads exactly like a rejected key.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println(llmcreq.chat_path(llmcreq.openai("sk-test")))
//     // : /v1/chat/completions
// ```
pub fn chat_path(p: LlmcProvider) -> Str []
    match p.dialect
        LlmcOpenAiChat        => "/v1/chat/completions"
        LlmcAnthropicMessages => "/v1/messages"

// Every header this provider puts on every request, in order.
//
// `Authorization: Bearer …` for the OpenAI dialect, `x-api-key` plus
// `anthropic-version` for Anthropic's, `Content-Type`, the
// organization when set, and the caller's extras last so a gateway can
// override.  The key is only present when `key_is_set`.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${list.len(llmcreq.auth_headers(llmcreq.anthropic("sk-ant-test")))}")
// ```
pub fn auth_headers(p: LlmcProvider) -> [Str] []
    var hs: [Str] = []
    if key_is_set(p)
        match p.dialect
            LlmcOpenAiChat        => list.push(hs, "Authorization: Bearer ${p.api_key}")
            LlmcAnthropicMessages => list.push(hs, "x-api-key: ${p.api_key}")
    if p.dialect == LlmcAnthropicMessages and p.api_version != ""
        list.push(hs, "anthropic-version: ${p.api_version}")
    list.push(hs, "Content-Type: application/json")
    if p.organization != ""
        list.push(hs, "OpenAI-Organization: ${p.organization}")
    for h in p.extra_headers
        list.push(hs, h)
    hs

// One tool the model may ask for.
//
// `parameters` is a JSON Schema object — an `{"type": "object", …}`
// document.  schema-nv compiles one, and `check` is where a document
// that is not a schema is caught here rather than as a provider's 400.
pub struct LlmcToolDef
    name: Str
    description: Str
    parameters: JsonValueH

// Describe one tool.
//
// ```novo
// use llmcreq
// use std.json
//
// fn main() [io]
//     let t = llmcreq.tool("now", "the time", json.object([]))
//     println(t.name)
//     // : now
// ```
pub fn tool(name: Str, description: Str, parameters: JsonValueH) -> LlmcToolDef []
    LlmcToolDef { name: name, description: description, parameters: parameters }

// Which tool, if any, the model must call this turn.
pub enum LlmcToolChoice
    // The model decides.  Every provider's default.
    LlmcToolAuto
    // The model may not call a tool this turn.
    LlmcToolNone
    // The model must call SOME tool.  A refusal rather than a
    // preference: a model that answered in prose has not followed it.
    LlmcToolRequired
    // The model must call THIS tool.
    LlmcToolNamed(name: Str)

// What shape the reply's text must take.
pub enum LlmcFormat
    // Prose.  The default.
    LlmcFormatText
    // Valid JSON, with no schema.  Both dialects support it under
    // different names, and NEITHER guarantees which JSON: a model
    // asked for "an object" may answer `[]`.
    LlmcFormatJson
    // Valid JSON matching a schema.  `strict` asks the provider to
    // CONSTRAIN decoding rather than to prompt for it, which is the
    // difference between a promise and a guarantee — and which several
    // OpenAI-compatible servers accept and then ignore.  `llmcchat`
    // publishes `validate_format` so a caller checks rather than
    // trusts.
    LlmcFormatSchema(name: Str, schema: JsonValueH, strict: Bool)

// Sampling and limits.
//
// `-1` means "not set, let the provider default", for every integer
// field, and a negative float means the same — because 0 is a
// meaningful temperature and a meaningful `top_p` and an
// `Int` that defaulted to 0 would have silenced the model.
pub struct LlmcParams
    // The reply's cap in tokens.  REQUIRED by the Anthropic dialect,
    // optional in the OpenAI one, and `check` is where that difference
    // is refused rather than discovered as a 400.
    max_tokens: Int
    temperature: Float
    top_p: Float
    // Sequences that end the reply.  The reply's `stop` says which one
    // fired, which is the part a caller usually needs and which most
    // clients drop.
    stop: [Str]
    // OpenAI's reproducibility hint.  Anthropic has no spelling for
    // it, so a request that sets it against that dialect is
    // `LlmcUnsupported` rather than silently unreproducible.
    seed: Int

// Every field unset.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${llmcreq.params().max_tokens}")
//     // : -1
// ```
pub fn params() -> LlmcParams []
    LlmcParams { max_tokens: 0 - 1, temperature: 0.0 - 1.0, top_p: 0.0 - 1.0,
                 stop: [], seed: 0 - 1 }

// The same parameters with a reply cap.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${llmcreq.with_max_tokens(llmcreq.params(), 1024).max_tokens}")
//     // : 1024
// ```
pub fn with_max_tokens(p: LlmcParams, n: Int) -> LlmcParams []
    LlmcParams { max_tokens: n, temperature: p.temperature, top_p: p.top_p,
                 stop: p.stop, seed: p.seed }

// The same parameters with a sampling temperature.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${llmcreq.with_temperature(llmcreq.params(), 0.0).temperature}")
// ```
pub fn with_temperature(p: LlmcParams, t: Float) -> LlmcParams []
    LlmcParams { max_tokens: p.max_tokens, temperature: t, top_p: p.top_p,
                 stop: p.stop, seed: p.seed }

// The same parameters with nucleus sampling.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${llmcreq.with_top_p(llmcreq.params(), 0.9).top_p}")
// ```
pub fn with_top_p(p: LlmcParams, v: Float) -> LlmcParams []
    LlmcParams { max_tokens: p.max_tokens, temperature: p.temperature, top_p: v,
                 stop: p.stop, seed: p.seed }

// The same parameters with stop sequences.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${list.len(llmcreq.with_stop(llmcreq.params(), ["END"]).stop)}")
//     // : 1
// ```
pub fn with_stop(p: LlmcParams, stop: [Str]) -> LlmcParams []
    LlmcParams { max_tokens: p.max_tokens, temperature: p.temperature,
                 top_p: p.top_p, stop: stop, seed: p.seed }

// The same parameters with OpenAI's seed.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${llmcreq.with_seed(llmcreq.params(), 7).seed}")
//     // : 7
// ```
pub fn with_seed(p: LlmcParams, seed: Int) -> LlmcParams []
    LlmcParams { max_tokens: p.max_tokens, temperature: p.temperature,
                 top_p: p.top_p, stop: p.stop, seed: seed }

// One request, before it has been rendered into either dialect.
//
// `convo` is prompt-nv's `PromptConvo`, which is the project's chat
// message list; this package owns no message type of its own, and the
// module header of `promptmsg` says why that type exists at all.
pub struct LlmcRequest
    model: Str
    convo: PromptConvo
    tools: [LlmcToolDef]
    tool_choice: LlmcToolChoice
    format: LlmcFormat
    params: LlmcParams
    // Whether the reply arrives as SSE frames.  A field on the
    // request rather than a second function, because everything else
    // about the two is identical and a caller switching between them
    // should not rewrite a call.
    stream: Bool

// A request for a model and a conversation, with no tools and no
// format.
//
// ```novo
// use llmcreq
// use promptmsg
//
// fn main() [io]
//     let c = promptmsg.convo([promptmsg.user("hello")])
//     println(llmcreq.request("gpt-4o-mini", c).model)
//     // : gpt-4o-mini
// ```
pub fn request(model: Str, c: PromptConvo) -> LlmcRequest []
    LlmcRequest { model: model, convo: c, tools: [], tool_choice: LlmcToolAuto,
                  format: LlmcFormatText, params: params(), stream: false }

// The same request offering a tool set.
//
// ```novo
// use llmcreq
// use promptmsg
// use std.json
//
// fn main() [io]
//     let r = llmcreq.request("gpt-4o-mini", promptmsg.empty_convo())
//     let t = llmcreq.tool("now", "the time", json.object([]))
//     println("${list.len(llmcreq.with_tools(r, [t]).tools)}")
//     // : 1
// ```
pub fn with_tools(r: LlmcRequest, tools: [LlmcToolDef]) -> LlmcRequest []
    LlmcRequest { model: r.model, convo: r.convo, tools: tools,
                  tool_choice: r.tool_choice, format: r.format, params: r.params,
                  stream: r.stream }

// The same request constraining which tool the model may call.
//
// ```novo
// use llmcreq
// use promptmsg
//
// fn main() [io]
//     let r = llmcreq.with_tool_choice(llmcreq.request("gpt-4o-mini",
//                                                      promptmsg.empty_convo()),
//                                      LlmcToolRequired)
//     println("${list.len(r.tools)}")
//     // : 0
// ```
pub fn with_tool_choice(r: LlmcRequest, choice: LlmcToolChoice) -> LlmcRequest []
    LlmcRequest { model: r.model, convo: r.convo, tools: r.tools,
                  tool_choice: choice, format: r.format, params: r.params,
                  stream: r.stream }

// The same request asking for a shaped reply.
//
// ```novo
// use llmcreq
// use promptmsg
//
// fn main() [io]
//     let r = llmcreq.with_format(llmcreq.request("gpt-4o-mini",
//                                                 promptmsg.empty_convo()),
//                                 LlmcFormatJson)
//     println(r.model)
//     // : gpt-4o-mini
// ```
pub fn with_format(r: LlmcRequest, f: LlmcFormat) -> LlmcRequest []
    LlmcRequest { model: r.model, convo: r.convo, tools: r.tools,
                  tool_choice: r.tool_choice, format: f, params: r.params,
                  stream: r.stream }

// The same request with sampling parameters.
//
// ```novo
// use llmcreq
// use promptmsg
//
// fn main() [io]
//     let p = llmcreq.with_max_tokens(llmcreq.params(), 512)
//     let r = llmcreq.with_params(llmcreq.request("claude-haiku-4-5",
//                                                 promptmsg.empty_convo()), p)
//     println("${r.params.max_tokens}")
//     // : 512
// ```
pub fn with_params(r: LlmcRequest, p: LlmcParams) -> LlmcRequest []
    LlmcRequest { model: r.model, convo: r.convo, tools: r.tools,
                  tool_choice: r.tool_choice, format: r.format, params: p,
                  stream: r.stream }

// The same request, streamed.
//
// ```novo
// use llmcreq
// use promptmsg
//
// fn main() [io]
//     let r = llmcreq.streaming(llmcreq.request("gpt-4o-mini",
//                                               promptmsg.empty_convo()))
//     println("${r.stream}")
//     // : true
// ```
pub fn streaming(r: LlmcRequest) -> LlmcRequest []
    LlmcRequest { model: r.model, convo: r.convo, tools: r.tools,
                  tool_choice: r.tool_choice, format: r.format, params: r.params,
                  stream: true }

// Whether this request can be spoken in this dialect at all.
//
// Called by every encoder before a byte is built, and worth calling
// directly from a test.  What it refuses, each of which is otherwise a
// 400 with a sentence in it:
//
//   NO `max_tokens` AGAINST THE ANTHROPIC DIALECT.  That API requires
//   the field and there is no default; the OpenAI one has one.
//
//   A `seed` AGAINST THE ANTHROPIC DIALECT, which has no spelling for
//   it.  `LlmcUnsupported`, naming the feature and the dialect, rather
//   than a request that is quietly less reproducible than the caller
//   believes.
//
//   TWO TOOLS WITH ONE NAME.  The model picks by name, so the second
//   definition is unreachable and the first one answers for it.
//
//   A TOOL NAME THE PROVIDERS REFUSE — both accept letters, digits,
//   underscores and hyphens only, and both answer 400 on anything
//   else.
//
//   `LlmcToolNamed` OR `LlmcToolRequired` WITH AN EMPTY TOOL SET,
//   which asks the model to call one of nothing.
//
//   A CONVERSATION WHOSE TOOL RESULTS DO NOT MATCH ITS TOOL CALLS.
//   That is the load-bearing check and `llmcreply.owed_tool_results`
//   is its other half; the README argues it.
//
// ```novo
// use llmcreq
// use promptmsg
//
// fn main() [io]
//     let r = llmcreq.request("claude-haiku-4-5", promptmsg.empty_convo())
//     match llmcreq.check(r, LlmcAnthropicMessages)
//         Ok(n)  => println("${n}")
//         Err(_) => println("refused: anthropic requires max_tokens")
// ```
pub fn check(r: LlmcRequest, d: LlmcDialect) -> Result<Int, LlmcFault> []
    if r.model == ""
        return Err(LlmcBadEncoding("the request names no model"))
    let n = match promptmsg.check(r.convo)
        Ok(count) => count
        Err(f)    =>
            return Err(LlmcBadEncoding(f.message()))
    if r.params.max_tokens == 0
        return Err(LlmcBadEncoding("max_tokens is zero, which asks for an empty reply"))
    if d == LlmcAnthropicMessages
        if r.params.max_tokens < 0
            return Err(LlmcBadEncoding("max_tokens is required by the anthropic dialect and the request has none"))
        if r.params.seed >= 0
            return Err(LlmcUnsupported("seed", "anthropic"))
        match r.format
            LlmcFormatJson            =>
                return Err(LlmcUnsupported("a JSON response format with no schema", "anthropic"))
            LlmcFormatSchema(_, _, _) =>
                if list.len(r.tools) > 0
                    return Err(LlmcUnsupported("a response schema beside tools", "anthropic"))
            LlmcFormatText            => 0
    check_tools(r)!
    check_tool_results(r.convo)!
    Ok(n)

// Whether a tool name is one both providers accept.
//
// Letters, digits, underscore and hyphen, 1 to 64 characters.
//
// ```novo
// use llmcreq
//
// fn main() [io]
//     println("${llmcreq.is_tool_name("get_weather")}")
//     // : true
// ```
pub fn is_tool_name(name: Str) -> Bool []
    let n = str.len(name)
    if n < 1 or n > 64
        return false
    for i in 0..n
        let b = str.byte_at_or(name, i, 0)
        let ok = b >= 48 and b <= 57 or b >= 65 and b <= 90 or b >= 97 and b <= 122 or b == 95 or b == 45
        if not ok
            return false
    true

// What the rendered request will cost in tokens, counted with the
// caller's own tokenizer.
//
// WHAT THIS NUMBER IS WORTH, stated here because a client that implied
// more would be lying: against a HOSTED model the tokenizer is the
// provider's and is not published, so this is an estimate from
// whatever vocabulary the caller loaded.  Against a LOCAL model served
// from a checkpoint whose `tokenizer.json` the caller read, it is
// exact.  `LlmcReply.usage` is the truth in both cases, and it arrives
// after the money is spent — which is the whole reason to estimate
// first.
//
// `promptbudget.convo_tokens` counts the conversation; this adds what
// the conversation does not contain and the wire does — the tool
// schemas, the response format, and the per-turn markers each family
// spends.
//
// ```novo
// use llmcreq
// use promptmsg
// use tokvocab
// use tokmodel
//
// fn cost(m: TokModel) -> Int
//     llmcreq.request_tokens(m, llmcreq.request("gpt-4o-mini",
//                                               promptmsg.empty_convo()))
// ```
pub fn request_tokens(m: TokModel, r: LlmcRequest) -> Int []
    var total = 3 + tools_tokens(m, r.tools)
    for msg in r.convo.messages
        total = total + 4 + tokmodel.token_count(m, msg.text) + tokmodel.token_count(m, msg.name)
    match r.format
        LlmcFormatSchema(name, schema, _) =>
            total = total + 8 + tokmodel.token_count(m, name)
                    + tokmodel.token_count(m, json.stringify(schema))
        LlmcFormatJson                    =>
            total = total + 4
        LlmcFormatText                    => 0
    total

// What the tool definitions alone cost.
//
// Separate because it is the number that surprises people: a
// thirty-tool catalogue is sent on EVERY turn of an agent loop, and it
// is usually the largest single part of the request.
//
// ```novo
// use llmcreq
// use tokmodel
//
// fn cost(m: TokModel, ts: [LlmcToolDef]) -> Int
//     llmcreq.tools_tokens(m, ts)
// ```
pub fn tools_tokens(m: TokModel, tools: [LlmcToolDef]) -> Int []
    var total = 0
    for t in tools
        total = total + 7 + tokmodel.token_count(m, t.name)
                + tokmodel.token_count(m, t.description)
                + tokmodel.token_count(m, json.stringify(t.parameters))
    total

// Refuse a request that will not fit, locally, before it is sent.
//
// `limit` is the model's context window minus the reply cap, and the
// caller supplies it because no API publishes it in a form a client
// can read.  Answers the count when it fits and
// `LlmcBudgetExceeded(wanted, limit)` when it does not.
//
// ```novo
// use llmcreq
// use tokmodel
//
// fn fits(m: TokModel, r: LlmcRequest) -> Bool
//     match llmcreq.check_budget(m, r, 8192)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn check_budget(m: TokModel, r: LlmcRequest, limit: Int) -> Result<Int, LlmcFault> []
    let wanted = request_tokens(m, r)
    if wanted > limit
        Err(LlmcBudgetExceeded(wanted, limit))
    else
        Ok(wanted)

// The tool set against the choice: names the providers accept, no name
// twice, and a forced choice that has something to force.
fn check_tools(r: LlmcRequest) -> Result<Int, LlmcFault>
    var seen: [Str] = []
    for t in r.tools
        if not is_tool_name(t.name)
            return Err(LlmcBadEncoding("the tool name \"${t.name}\" is not 1 to 64 letters, digits, underscores or hyphens"))
        if list.contains(seen, t.name)
            return Err(LlmcBadEncoding("two tools are named ${t.name}"))
        list.push(seen, t.name)
    match r.tool_choice
        LlmcToolRequired    =>
            if list.len(r.tools) == 0
                return Err(LlmcBadEncoding("a tool is required and none is offered"))
        LlmcToolNamed(name) =>
            if not list.contains(seen, name)
                return Err(LlmcBadEncoding("the tool ${name} is forced and is not offered"))
        _                   => 0
    match r.format
        LlmcFormatSchema(name, _, _) =>
            if not is_tool_name(name)
                return Err(LlmcBadEncoding("the schema name \"${name}\" is not 1 to 64 letters, digits, underscores or hyphens"))
        _                            => 0
    Ok(list.len(r.tools))

// The conversation's tool calls against its tool results.
//
// An assistant message that carries a tool name and a call id IS a
// tool call (`llmcreply.to_messages` writes them).  Every result must
// answer a call made before it, and every call must have its result
// after it: the first is a 400 from Anthropic, the second a 400 from
// Anthropic and a model answering as though the tool returned nothing
// from the other dialect.
fn check_tool_results(c: PromptConvo) -> Result<Int, LlmcFault>
    let ms = c.messages
    for i in 0..list.len(ms)
        let m = ms[i]
        if m.role == PromptTool
            if m.call_id == ""
                return Err(LlmcBadEncoding("a tool result at position ${i} names no call id"))
            if not has_call_before(ms, i, m.call_id)
                return Err(LlmcBadEncoding("the tool result at position ${i} answers call id ${m.call_id}, which no assistant turn made"))
        elif is_call(m)
            if not has_result_after(ms, i, m.call_id)
                return Err(LlmcBadEncoding("the tool call ${m.call_id} at position ${i} has no result after it"))
    Ok(list.len(ms))

// Whether a message is an assistant turn's tool call.
pub fn is_call(m: PromptMessage) -> Bool
    m.role == PromptAssistant and m.call_id != "" and m.name != ""

fn has_call_before(ms: [PromptMessage], upto: Int, id: Str) -> Bool
    for i in 0..upto
        if is_call(ms[i]) and ms[i].call_id == id
            return true
    false

fn has_result_after(ms: [PromptMessage], from: Int, id: Str) -> Bool
    for i in from + 1..list.len(ms)
        if ms[i].role == PromptTool and ms[i].call_id == id
            return true
    false

// Whether a model name carries a provider prefix.
//
// `openai:gpt-4o-mini` is the form `std.llm` takes and no endpoint
// accepts.  A colon is not enough to say so: Ollama's own names are
// `llama3:8b`, a tag.  So the prefix has to be a provider this package
// knows by name.
pub fn is_qualified_model(name: Str) -> Bool
    match str.index(name, ":")
        None     => false
        Some(at) =>
            let prefix = str.lower(str.slice(name, 0, at))
            list.contains(["openai", "anthropic", "groq", "ollama", "together", "google",
                           "mistral", "xai", "deepseek", "azure", "bedrock", "vertex",
                           "fireworks", "openrouter"],
                           prefix)
