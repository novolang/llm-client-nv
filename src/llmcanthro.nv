// llmcanthro.nv — Anthropic's Messages dialect.
//
// `core`-shaped inside a `host` package, like `llmcopenai`: every row
// here is `[]` and a whole exchange is a byte array in a test.
//
// WHAT IS DIFFERENT FROM THE OTHER DIALECT, which is the whole reason
// this is a second module and not a flag:
//
//   THE SYSTEM PROMPT IS A TOP-LEVEL FIELD, not the first message.  A
//   client that sent `{"role": "system"}` in the array gets a 400
//   naming the role, so `encode_messages` LIFTS it out and
//   `encode_system` is the half that answers it.
//
//   `max_tokens` IS REQUIRED.  There is no default, and the request is
//   refused without it.  `llmcreq.check` is where that is caught,
//   before the bytes leave.
//
//   CONTENT IS A BLOCK LIST IN BOTH DIRECTIONS.  An assistant turn is
//   `[{"type": "text", …}, {"type": "tool_use", …}]`, so text and
//   tool calls INTERLEAVE, and a model that said "let me look that
//   up" and then called a tool produced one turn with two blocks.  The
//   OpenAI dialect has `content` and `tool_calls` as separate fields
//   and loses the order; `LlmcReply` keeps the text and the calls
//   apart because that is the shape both can be read as, and this
//   module's `blocks_of` is published for the caller that needs the
//   interleaving back.
//
//   A TOOL RESULT IS A `user` MESSAGE, not a role of its own.  Its
//   content is a `tool_result` block carrying `tool_use_id`.  A client
//   that invented a `"tool"` role here gets a 400; one that sent the
//   result as plain user text gets an answer, and the answer is the
//   model guessing, because nothing tied the text to the call.
//
//   THE ERROR BODY IS `{"type": "error", "error": {"type": …}}`, and
//   the codes are Anthropic's own — `overloaded_error` is 529, which
//   is the one status whose right answer is a LONGER wait rather than
//   a faster retry, and `llmcfault.LlmcOverloaded` exists for it.
//
//   THE STREAM NAMES ITS FRAMES.  `message_start`,
//   `content_block_start`, `content_block_delta`, `content_block_stop`,
//   `message_delta`, `message_stop`, `ping` — so `events_of_frame`
//   reads the `event:` field here and reads inside the data on the
//   other dialect.  Usage arrives on `message_delta` WITHOUT being
//   asked for, which the other dialect does not do.

use std.json
use std.list
use std.str
use promptmsg
use llmcfault
use llmcreq
use llmcreply
use llmcsse

// Anthropic's own origin.
pub const LLMC_ANTHROPIC_BASE_URL = "https://api.anthropic.com"

// The Messages endpoint's path.
pub const LLMC_ANTHROPIC_CHAT_PATH = "/v1/messages"

// The `anthropic-version` this package was written against.
//
// A constant rather than a default buried in a constructor, because it
// pins the RESPONSE shape: a client that sent a different one is
// reading fields this module's decoders do not expect.
pub const LLMC_ANTHROPIC_VERSION = "2023-06-01"

// The whole request body, as a JSON value.
//
// Calls `llmcreq.check` first, which is where a missing `max_tokens`
// and a `seed` this dialect cannot spell are refused.
//
// ```novo
// use llmcanthro
// use llmcreq
//
// fn body(p: LlmcProvider, r: LlmcRequest) -> Bool
//     match llmcanthro.encode_request(p, r)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn encode_request(p: LlmcProvider, r: LlmcRequest) -> Result<JsonValueH, LlmcFault> []
    llmcreq.check(r, LlmcAnthropicMessages)!
    var kv: [(Str, JsonValueH)] = []
    list.push(kv, ("model", json.string(r.model)))
    list.push(kv, ("max_tokens", json.int(r.params.max_tokens)))
    let preamble = encode_system(r.convo)
    if preamble != ""
        list.push(kv, ("system", json.string(preamble)))
    list.push(kv, ("messages", encode_messages(r.convo)!))
    var tools: [JsonValueH] = []
    for t in r.tools
        list.push(tools, encode_tool(t))
    var choice = r.tool_choice
    match r.format
        LlmcFormatSchema(name, _, _) =>
            list.push(tools, encode_format(r.format)!)
            choice = LlmcToolNamed(name)
        _                            => 0
    if list.len(tools) > 0
        list.push(kv, ("tools", json.array(tools)))
        match choice
            LlmcToolAuto => 0
            _            => list.push(kv, ("tool_choice", encode_tool_choice(choice)))
    if r.params.temperature >= 0.0
        list.push(kv, ("temperature", json.float(r.params.temperature)))
    if r.params.top_p >= 0.0
        list.push(kv, ("top_p", json.float(r.params.top_p)))
    if list.len(r.params.stop) > 0
        var stops: [JsonValueH] = []
        for s in r.params.stop
            list.push(stops, json.string(s))
        list.push(kv, ("stop_sequences", json.array(stops)))
    if r.stream
        list.push(kv, ("stream", json.bool(true)))
    Ok(json.object(kv))

// The same body, serialised.
//
// ```novo
// use llmcanthro
// use llmcreq
//
// fn bytes(p: LlmcProvider, r: LlmcRequest) -> Str
//     match llmcanthro.encode_body(p, r)
//         Ok(s)  => s
//         Err(_) => ""
// ```
pub fn encode_body(p: LlmcProvider, r: LlmcRequest) -> Result<Str, LlmcFault> []
    Ok(json.stringify(encode_request(p, r)!))

// The conversation's system message as this dialect's top-level
// `system` field, or empty.
//
// ```novo
// use llmcanthro
// use promptmsg
//
// fn main() [io]
//     println(llmcanthro.encode_system(promptmsg.empty_convo()))
//     // :
// ```
pub fn encode_system(c: PromptConvo) -> Str []
    match promptmsg.system_of(c)
        Some(m) => m.text
        None    => ""

// The conversation's body as this dialect's `messages` array, with the
// system message LIFTED OUT.
//
// A system message left in the array is a 400 naming the role, which
// is the first thing a client ported from the other dialect hits.
//
// ```novo
// use llmcanthro
// use promptmsg
//
// fn many(c: PromptConvo) -> Bool
//     match llmcanthro.encode_messages(c)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn encode_messages(c: PromptConvo) -> Result<JsonValueH, LlmcFault> []
    var out: [JsonValueH] = []
    let ms = promptmsg.body_of(c)
    var i = 0
    while i < list.len(ms)
        let m = ms[i]
        if m.role == PromptTool
            var results: [JsonValueH] = []
            var k = i
            while k < list.len(ms) and ms[k].role == PromptTool
                list.push(results, result_block(ms[k].call_id, ms[k].text, false))
                k = k + 1
            list.push(out, json.object([("role", json.string("user")),
                                        ("content", json.array(results))]))
            i = k
        else
            var j = i + 1
            if llmcreq.is_call(m)
                j = i
            var calls: [PromptMessage] = []
            while m.role == PromptAssistant and j < list.len(ms) and llmcreq.is_call(ms[j])
                list.push(calls, ms[j])
                j = j + 1
            if list.len(calls) > 0
                var text = ""
                if not llmcreq.is_call(m)
                    text = m.text
                list.push(out, assistant_blocks(text, calls))
                i = j
            else
                list.push(out, encode_message(m)!)
                i = i + 1
    Ok(json.array(out))

// One prompt-nv message as this dialect's message object.
//
// A `PromptTool` message becomes a `user` message whose single content
// block is a `tool_result` carrying `tool_use_id` — not a role of its
// own, which this dialect has no spelling for.
//
// ```novo
// use llmcanthro
// use promptmsg
//
// fn one(m: PromptMessage) -> Bool
//     match llmcanthro.encode_message(m)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn encode_message(m: PromptMessage) -> Result<JsonValueH, LlmcFault> []
    if m.role == PromptSystem
        return Err(LlmcBadEncoding("the system message goes in the top-level system field, not the messages array"))
    if m.role == PromptTool
        if m.call_id == ""
            return Err(LlmcBadEncoding("a tool result names no call id"))
        return Ok(tool_result_message(m.call_id, m.text, false))
    if llmcreq.is_call(m)
        return Ok(assistant_blocks("", [m]))
    Ok(json.object([("role", json.string(promptmsg.role_name(m.role))),
                    ("content", json.string(m.text))]))

// One tool definition as `{"name": …, "description": …,
// "input_schema": …}`.
//
// `input_schema` and not `parameters`, and no `{"type": "function"}`
// wrapper — the two dialects spell the same facts differently, which
// is most of what these modules are.
//
// ```novo
// use llmcanthro
// use llmcreq
// use std.json
//
// fn main() [io]
//     let t = llmcreq.tool("now", "the time", json.object([]))
//     println(json.type_of(llmcanthro.encode_tool(t)))
//     // : object
// ```
pub fn encode_tool(t: LlmcToolDef) -> JsonValueH []
    json.object([("name", json.string(t.name)),
                 ("description", json.string(t.description)),
                 ("input_schema", t.parameters)])

// A tool choice as this dialect's `tool_choice` object.
//
// `{"type": "auto"}`, `{"type": "none"}`, `{"type": "any"}` —
// `any` and not `required`, which is the spelling difference a client
// ported across gets a 400 for — or `{"type": "tool", "name": …}`.
//
// ```novo
// use llmcanthro
// use llmcreq
// use std.json
//
// fn main() [io]
//     println(json.type_of(llmcanthro.encode_tool_choice(LlmcToolRequired)))
//     // : object
// ```
pub fn encode_tool_choice(c: LlmcToolChoice) -> JsonValueH []
    match c
        LlmcToolAuto        => json.object([("type", json.string("auto"))])
        LlmcToolNone        => json.object([("type", json.string("none"))])
        LlmcToolRequired    => json.object([("type", json.string("any"))])
        LlmcToolNamed(name) =>
            json.object([("type", json.string("tool")), ("name", json.string(name))])

// A response format, as far as this dialect has one.
//
// This API has no `response_format` field.  Structured output is
// obtained by offering ONE tool whose input schema is the shape and
// forcing it with `tool_choice`, which is the documented approach and
// what this encodes — so `LlmcFormatSchema` becomes a tool named for
// the schema, and the reply's tool-call arguments are the JSON.
// `llmcchat.decode` puts them back in `text` so a caller that asked
// for a shape reads it in the same place under either dialect.
//
// `LlmcFormatJson` with no schema is `LlmcUnsupported`, named:
// "valid JSON, unspecified shape" has no spelling here at all, and a
// client that quietly dropped the request would return prose to a
// caller that will parse it.
//
// ```novo
// use llmcanthro
// use llmcreq
//
// fn fmt() -> Bool
//     match llmcanthro.encode_format(LlmcFormatJson)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn encode_format(f: LlmcFormat) -> Result<JsonValueH, LlmcFault> []
    match f
        LlmcFormatText                    => Ok(json.null())
        LlmcFormatJson                    =>
            Err(LlmcUnsupported("a JSON response format with no schema", "anthropic"))
        LlmcFormatSchema(name, schema, _) =>
            Ok(json.object([("name", json.string(name)),
                            ("description", json.string("Answer in exactly this shape.")),
                            ("input_schema", schema)]))

// The assistant turn as this dialect writes it, blocks and all.
//
// The lossless form, for a caller replaying a transcript: text and
// tool-use blocks in the order the model produced them.
//
// ```novo
// use llmcanthro
// use llmcreply
// use std.json
//
// fn main() [io]
//     println(json.type_of(llmcanthro.assistant_turn(llmcreply.empty_reply())))
//     // : object
// ```
pub fn assistant_turn(r: LlmcReply) -> JsonValueH []
    var calls: [PromptMessage] = []
    for c in r.tool_calls
        list.push(calls, PromptMessage { role: PromptAssistant, text: c.arguments,
                                         name: c.name, call_id: c.id })
    assistant_blocks(r.text, calls)

// One tool result as this dialect's `user` message.
//
// `is_error` is a FIELD on the block and not an exception, because a
// tool that failed is something the MODEL must see: a loop that hid
// the failure and sent nothing gets the same call again, and a loop
// that raised gets a program that cannot recover from a transient
// tool.
//
// ```novo
// use llmcanthro
// use std.json
//
// fn main() [io]
//     let m = llmcanthro.tool_result_message("toolu_1", "17 degrees", false)
//     println(json.type_of(m))
//     // : object
// ```
pub fn tool_result_message(call_id: Str, content: Str, is_error: Bool) -> JsonValueH []
    json.object([("role", json.string("user")),
                 ("content", json.array([result_block(call_id, content, is_error)]))])

// A buffered 200 body as a reply.
//
// ```novo
// use llmcanthro
//
// fn read(body: Str) -> Bool
//     match llmcanthro.decode_reply(body)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn decode_reply(body: Str) -> Result<LlmcReply, LlmcFault> []
    match json.parse(body)
        Some(v) => decode_value(v)
        None    => Err(LlmcMalformedReply("body as JSON"))

// The same, from a value a caller already parsed.
//
// ```novo
// use llmcanthro
// use std.json
//
// fn read(v: JsonValueH) -> Bool
//     match llmcanthro.decode_value(v)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn decode_value(v: JsonValueH) -> Result<LlmcReply, LlmcFault> []
    let blocks = match json.get_list(v, "content")
        Some(b) => b
        None    =>
            return Err(LlmcMalformedReply("content"))
    var text = ""
    var calls: [LlmcToolCall] = []
    for b in blocks
        let kind = json.get_str(b, "type") ?? ""
        if kind == "text"
            text = text + (json.get_str(b, "text") ?? "")
        elif kind == "tool_use"
            list.push(calls, LlmcToolCall { id: json.get_str(b, "id") ?? "",
                                            name: json.get_str(b, "name") ?? "",
                                            arguments: json.stringify(json.get(b, "input") ?? json.object([])) })
    Ok(LlmcReply { stop: stop_of(json.get_str(v, "stop_reason") ?? "",
                                 json.get_str(v, "stop_sequence") ?? ""),
                   text: text, tool_calls: calls,
                   usage: decode_usage(json.get(v, "usage") ?? json.null()),
                   model: json.get_str(v, "model") ?? "",
                   id: json.get_str(v, "id") ?? "" })

// The content blocks of a reply, in the order they arrived.
//
// Published because `LlmcReply` keeps text and tool calls apart and
// this dialect INTERLEAVES them: a model that explained itself between
// two tool calls produced three blocks, and a transcript that wants to
// show that needs the order.  The common reader does not.
//
// ```novo
// use llmcanthro
// use std.json
//
// fn blocks(v: JsonValueH) -> Int
//     list.len(llmcanthro.blocks_of(v))
// ```
pub fn blocks_of(v: JsonValueH) -> [JsonValueH] []
    json.get_list(v, "content") ?? []

// The `usage` object, or every field zero.
//
// This dialect reports `cache_creation_input_tokens` and
// `cache_read_input_tokens` separately; the read count lands in
// `cached_input_tokens` and the creation count does not, because it is
// billed at a PREMIUM rather than a discount and a caller adding it to
// the cached total would compute a cost that is wrong in the cheap
// direction.
//
// ```novo
// use llmcanthro
// use std.json
//
// fn main() [io]
//     println("${llmcanthro.decode_usage(json.object([])).output_tokens}")
//     // : 0
// ```
pub fn decode_usage(v: JsonValueH) -> LlmcUsage []
    let read = json.get_int(v, "cache_read_input_tokens") ?? 0
    let made = json.get_int(v, "cache_creation_input_tokens") ?? 0
    LlmcUsage { input_tokens: (json.get_int(v, "input_tokens") ?? 0) + read + made,
                output_tokens: json.get_int(v, "output_tokens") ?? 0,
                cached_input_tokens: read, reasoning_tokens: 0 }

// A non-2xx status and its body as a fault.
//
// Reads `error.type` into `provider_code`, and answers
// `LlmcOverloaded` for 529 — this API's own "at capacity" status,
// which is not a server error and whose right answer is a longer wait.
//
// ```novo
// use llmcanthro
// use llmcfault
//
// fn main() [io]
//     println("${llmcfault.is_retryable(llmcanthro.decode_error(529, ""))}")
//     // : true
// ```
pub fn decode_error(status: Int, body: Str) -> LlmcFault []
    var message = str.trim(body)
    var code = ""
    match json.parse(body)
        Some(v) =>
            let err = json.get(v, "error") ?? json.null()
            message = json.get_str(err, "message") ?? message
            code = json.get_str(err, "type") ?? ""
        None    => 0
    if message == ""
        message = "the response had no body"
    match llmcfault.of_status(status, message)
        LlmcBadRequest(s, _, m) => LlmcBadRequest(s, code, m)
        other                   => other

// One SSE frame as the events it carries.
//
// Reads the `event:` field, which this dialect sets on every frame.
// `ping` answers `[LlmcEventPing]` and never an empty list, so a
// caller counting frames and a caller counting events agree.
//
// ```novo
// use llmcanthro
// use llmcsse
//
// fn events(f: LlmcSseFrame) -> Bool
//     match llmcanthro.events_of_frame(f)
//         Ok(_)  => true
//         Err(_) => false
// ```
pub fn events_of_frame(f: LlmcSseFrame) -> Result<[LlmcEvent], LlmcFault> []
    let v = match json.parse(f.data)
        Some(parsed) => parsed
        None         =>
            return Err(LlmcMalformedReply("stream event as JSON"))
    var kind = f.event
    if kind == ""
        kind = json.get_str(v, "type") ?? ""
    var events: [LlmcEvent] = []
    if kind == "ping"
        list.push(events, LlmcEventPing)
    elif kind == "message_start"
        let m = json.get(v, "message") ?? json.null()
        list.push(events, LlmcEventStart(json.get_str(m, "id") ?? "",
                                         json.get_str(m, "model") ?? ""))
        list.push(events, LlmcEventUsage(decode_usage(json.get(m, "usage") ?? json.null())))
    elif kind == "content_block_start"
        let index = json.get_int(v, "index") ?? 0
        let b = json.get(v, "content_block") ?? json.null()
        let btype = json.get_str(b, "type") ?? ""
        if btype == "tool_use"
            list.push(events, LlmcEventToolStart(index, json.get_str(b, "id") ?? "",
                                                 json.get_str(b, "name") ?? ""))
        elif btype == "text"
            let first = json.get_str(b, "text") ?? ""
            if first != ""
                list.push(events, LlmcEventText(first))
    elif kind == "content_block_delta"
        let index = json.get_int(v, "index") ?? 0
        let d = json.get(v, "delta") ?? json.null()
        let dtype = json.get_str(d, "type") ?? ""
        if dtype == "text_delta"
            list.push(events, LlmcEventText(json.get_str(d, "text") ?? ""))
        elif dtype == "input_json_delta"
            let part = json.get_str(d, "partial_json") ?? ""
            if part != ""
                list.push(events, LlmcEventToolArgs(index, part))
    elif kind == "message_delta"
        match json.get(v, "usage")
            Some(u) => list.push(events, LlmcEventUsage(decode_usage(u)))
            None    => 0
        let d = json.get(v, "delta") ?? json.null()
        match json.get_str(d, "stop_reason")
            Some(reason) =>
                list.push(events, LlmcEventStop(stop_of(reason, json.get_str(d, "stop_sequence") ?? "")))
            None         => 0
    elif kind == "message_stop"
        list.push(events, LlmcEventStop(LlmcStopEnd))
    elif kind == "error"
        return Err(error_event(v))
    Ok(events)

// Whether a model name is one this dialect accepts.
//
// A shape check: a bare name, not `anthropic:claude-…`.  The same
// refusal `llmcopenai.is_model_name` makes, and for the same reason —
// `std.llm` takes the provider-qualified form and this package does
// not.
//
// ```novo
// use llmcanthro
//
// fn main() [io]
//     println("${llmcanthro.is_model_name("claude-haiku-4-5")}")
//     // : true
// ```
pub fn is_model_name(name: Str) -> Bool []
    name != "" and not llmcreq.is_qualified_model(name)

// The stop a reply or a `message_delta` names, with the stop sequence
// that fired filled in.
fn stop_of(reason: Str, sequence: Str) -> LlmcStop
    match llmcreply.stop_of_anthropic(reason)
        LlmcStopSequence(_) => LlmcStopSequence(sequence)
        other               => other

// An assistant message as a block list: the text first when there is
// any, then one `tool_use` block per call.  A call whose arguments are
// not JSON is sent with an empty input rather than refused, because
// the model that wrote it is the one being corrected.
fn assistant_blocks(text: Str, calls: [PromptMessage]) -> JsonValueH
    var blocks: [JsonValueH] = []
    if text != ""
        list.push(blocks, json.object([("type", json.string("text")),
                                       ("text", json.string(text))]))
    for c in calls
        list.push(blocks, json.object([("type", json.string("tool_use")),
                                       ("id", json.string(c.call_id)),
                                       ("name", json.string(c.name)),
                                       ("input", json.parse(c.text) ?? json.object([]))]))
    json.object([("role", json.string("assistant")), ("content", json.array(blocks))])

// One `tool_result` block; `is_error` travels only when true.
fn result_block(call_id: Str, content: Str, is_error: Bool) -> JsonValueH
    var kv: [(Str, JsonValueH)] = [("type", json.string("tool_result")),
                                   ("tool_use_id", json.string(call_id)),
                                   ("content", json.string(content))]
    if is_error
        list.push(kv, ("is_error", json.bool(true)))
    json.object(kv)

// A stream's `error` event as the fault it names.
fn error_event(v: JsonValueH) -> LlmcFault
    let err = json.get(v, "error") ?? json.null()
    let kind = json.get_str(err, "type") ?? ""
    let message = json.get_str(err, "message") ?? "the stream reported an error"
    if kind == "overloaded_error"
        LlmcOverloaded(message)
    elif kind == "rate_limit_error"
        LlmcRateLimited(0 - 1, message)
    elif kind == "authentication_error" or kind == "permission_error"
        LlmcAuthFailed(401, message)
    elif kind == "invalid_request_error" or kind == "not_found_error"
        LlmcBadRequest(400, kind, message)
    else
        LlmcServerError(500, message)
